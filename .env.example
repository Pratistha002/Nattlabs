# Copy to Nattlabs/.env and fill in values, then run: docker compose up -d --build
# docker-compose.yml auto-reads a ".env" file in this same folder for these variables.

SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-brevo-login-email
SPRING_MAIL_PASSWORD=your-brevo-smtp-key

# Verified sender in your mail provider (Brevo -> Senders)
APP_MAIL_FROM=your-verified-sender@example.com

# Inboxes that receive contact form submissions (comma-separated)
APP_CONTACT_TO=support@nattlabs.com,careers@nattlabs.com
